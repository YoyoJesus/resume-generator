# OpenAI API key for resume extraction, AI tailoring, and DOCX template conversion.
OPENAI_API_KEY=

# O*NET Web Services key used by the /api/onet endpoints.
# Free developer signup: https://services.onetcenter.org/developer/signup
ONET_API_KEY=

# API protection uses fixed per-instance limits (6 AI / 60 O*NET requests per IP per minute).
# No database or extra environment variables are required. Configure provider budget
# alerts and deployment-level controls separately; see README deployment guidance.
# OpenAI timeout: 35 seconds, no retries. O*NET timeout: 10 seconds.
# Model output ceilings: 16,000 tokens extraction, 8,000 tailoring, 4,000 template conversion.
